APP_NAME=Silo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=filez
DB_USERNAME=root
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Set to true in production (HTTPS) so the session cookie is only sent over TLS.
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================================
# Silo — Application settings
# ============================================================

# --- Accounts ---
# Open self-service signup. When false, the /register routes return 404 and
# accounts are created by an admin.
ALLOW_REGISTRATION=false
# Admin account created by `php artisan db:seed` on a clean build (idempotent).
# CHANGE ADMIN_PASSWORD before any non-local deployment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
ADMIN_NAME=Administrator

# --- Storage ---
# Default storage disk for uploads (any disk from config/filesystems.php).
# Keep this PRIVATE ("local" / private s3). Files are served only through the
# policy-gated /raw/{file} route; a public/web-served disk exposes every blob
# by URL without authentication.
FILEMANAGER_DISK=local
# Max size per uploaded file, in KB. Leave blank to use PHP's own limit
# (the smaller of upload_max_filesize and post_max_size).
# FILEMANAGER_MAX_UPLOAD_KB=51200
# Per-user storage quota in MB (0 = unlimited).
FILEMANAGER_USER_QUOTA_MB=1024
# Days an item stays in the trash before trash:purge removes it for good.
FILEMANAGER_TRASH_RETENTION_DAYS=30

# --- Antivirus (optional) ---
# Scan every upload during processing. Requires clamd/clamscan on the host
# (uncomment the clamav service in docker-compose). Fails closed.
FILEMANAGER_AV_ENABLED=false
FILEMANAGER_AV_COMMAND="clamdscan --no-summary --fdpass"
FILEMANAGER_AV_TIMEOUT=120

# --- Notes surface ---
# Per-user root folder name for the Notes app.
FILEMANAGER_NOTES_FOLDER=Notes
# Minutes of continuous editing before autosave archives a new version
# ("Save version" always snapshots immediately).
FILEMANAGER_NOTES_SNAPSHOT_INTERVAL=10

# --- Secrets vault ---
# Dedicated 32-byte key (base64:) for encrypting vault secrets at rest. Generate
# with `php artisan vault:key`. If unset, falls back to APP_KEY. Server-side
# encryption (NOT zero-knowledge); back this key up — losing it is unrecoverable.
# VAULT_KEY=

# --- Search ---
# Full-text search engine: database | meilisearch | typesense | algolia
SCOUT_DRIVER=database

# ============================================================
# Notes
# ============================================================
# Import a server folder (a dir under public/, or a symlink/mount) in place:
#   1. Add a disk in config/filesystems.php, e.g.
#        'media' => ['driver' => 'local', 'root' => '/srv/media'],
#   2. php artisan files:import --disk=media --owner=<id-or-email> --name="Media"
#   Imported files are referenced in place (never copied, never deleted on purge).
#
# Production checklist:
# - Set MAIL_MAILER=smtp with real credentials, or password-reset / verification
#   mail silently goes to the log (MAIL_MAILER=log).
# - Run a queue worker (deploy/supervisor-worker.conf) or thumbnails, metadata,
#   and note link-parsing never run (files stay "Processing").
# - Run the scheduler (deploy/crontab) so trash:purge actually fires.
# - Set SESSION_SECURE_COOKIE=true and APP_DEBUG=false.
