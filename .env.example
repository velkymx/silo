APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:HPEqPDCuR+B2o778wFQF/x3rF2PtnZ0OHy4C2xzV7cw=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=filez
DB_USERNAME=root
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
FILESYSTEM_DISK=public

# --- File manager ---
# Default storage disk for uploads (any disk from config/filesystems.php).
FILEMANAGER_DISK=public
# Max size per uploaded file, in KB.
FILEMANAGER_MAX_UPLOAD_KB=5120
# Per-user storage quota in MB (0 = unlimited).
FILEMANAGER_USER_QUOTA_MB=1024
# Days an item stays in the trash before trash:purge removes it for good.
FILEMANAGER_TRASH_RETENTION_DAYS=30

# Full-text search engine: database | meilisearch | typesense | algolia
SCOUT_DRIVER=database

# IMPORTANT (production):
# - Set MAIL_MAILER=smtp with real credentials below, or password reset /
#   verification mail silently goes to the log (MAIL_MAILER=log).
# - Run a queue worker (see deploy/supervisor-worker.conf) or thumbnails and
#   metadata never get generated (files stay "Processing").
# - Run the scheduler (see deploy/crontab) so trash:purge actually runs.
