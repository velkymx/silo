APP_NAME="File Manager by AJBApps"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_LEVEL=info

# SQLite — zero external services, persisted on the storage volume.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/storage/app/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

SCOUT_DRIVER=database

# File manager.
FILEMANAGER_DISK=public
FILEMANAGER_USER_QUOTA_MB=1024
FILEMANAGER_TRASH_RETENTION_DAYS=30

# Antivirus (off by default; enable + add a clamav service to scan uploads).
FILEMANAGER_AV_ENABLED=false

# Import a mounted host folder in place (Docker bind mount at /import).
IMPORT_PATH=/import
